<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fruits and Vegetables Information</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:linear-gradient(to right,#b8f2b3,#f8ffd8);
    padding:30px;
}

h1{
    text-align:center;
    color:darkgreen;
    margin-bottom:25px;
}

.container{
    display:flex;
    justify-content:space-around;
    flex-wrap:wrap;
}

.box{
    width:40%;
    min-width:300px;
    background:white;
    border-radius:10px;
    padding:20px;
    margin:15px;
    box-shadow:0 0 10px gray;
}

h2{
    text-align:center;
    color:green;
    margin-bottom:15px;
}

ul{
    list-style:none;
}

li{
    background:#e8ffe8;
    margin:10px 0;
    padding:12px;
    border-radius:8px;
    cursor:pointer;
    transition:.3s;
    font-size:18px;
}

li:hover{
    background:green;
    color:white;
    transform:scale(1.05);
}

#infoBox{
    margin:30px auto;
    max-width:900px;
    background:white;
    padding:25px;
    border-radius:12px;
    box-shadow:0 0 15px gray;
}

#title{
    color:darkred;
    margin-bottom:15px;
}

img{
    width:220px;
    height:180px;
    object-fit:cover;
    border-radius:10px;
    margin-bottom:15px;
}

p{
    margin:8px 0;
    line-height:1.6;
}
</style>
</head>

<body>

<h1>🍎 Fruits and 🥕 Vegetables Information</h1>

<div class="container">

<div class="box">
<h2>🥕 Vegetables</h2>
<ul>
<li onclick="showInfo('Carrot')">🥕 Carrot</li>
<li onclick="showInfo('Potato')">🥔 Potato</li>
<li onclick="showInfo('Tomato')">🍅 Tomato</li>
<li onclick="showInfo('Brinjal')">🍆 Brinjal</li>
<li onclick="showInfo('Cabbage')">🥬 Cabbage</li>
</ul>
</div>

<div class="box">
<h2>🍓 Fruits</h2>
<ul>
<li onclick="showInfo('Apple')">🍎 Apple</li>
<li onclick="showInfo('Banana')">🍌 Banana</li>
<li onclick="showInfo('Mango')">🥭 Mango</li>
<li onclick="showInfo('Orange')">🍊 Orange</li>
<li onclick="showInfo('Grapes')">🍇 Grapes</li>
</ul>
</div>

</div>

<div id="infoBox">
<h2 id="title">Click any fruit or vegetable</h2>
<img id="image" src="https://via.placeholder.com/220x180?text=Food" alt="">
<p id="description">Its information will appear here.</p>
</div>

