<!DOCTYPE html>
<html>
<head>
    <title>Time Table</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f8fc;
        }

        .header {
            color: #003366;
        }

        .header h3 {
            margin: 5px;
        }

        .header h4 {
            color: #006699;
            margin: 5px;
        }

        .details {
            width: 100%;
            background-color: #d9eaf7;
            border: 1px solid #7aa7c7;
            padding: 8px;
        }

        .details td {
            padding: 8px;
            color: #00334d;
        }

        .timetable {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }

        .timetable th {
            background-color: #1565c0;
            color: white;
            padding: 10px;
            border: 1px solid #333;
        }

        .timetable td {
            text-align: center;
            padding: 10px;
            border: 1px solid #555;
            font-weight: bold;
        }

        .day {
            background-color: #bbdefb;
            color: #0d47a1;
        }

        /* Different colors for labs */
        .lab {
            background-color: #dcedc8;
            color: #33691e;
        }

        /* Subject colors */
        .subject1 {
            background-color: #fff3cd;
        }

        .subject2 {
            background-color: #e1bee7;
        }

        .subject3 {
            background-color: #b3e5fc;
        }

        .subject4 {
            background-color: #ffccbc;
        }

        /* Lunch and Break */
        .lunch {
            background-color: #ffb74d;
            color: #5d2f00;
            font-weight: bold;
        }

        .break {
            background-color: #ef9a9a;
            color: #7f0000;
            font-weight: bold;
        }
    </style>
</head>

<body>

<center>

    <div class="header">

        <img src="logo.png" width="350" height="80" alt="SASI Logo">

        <h3>Department of Information Technology</h3>
        <h4>ACADEMIC YEAR 2026 - 2027</h4>
        <h3>TIME TABLE</h3>

    </div>

    <table class="details">
        <tr>
            <td><b>Program:</b> B.Tech in IT</td>
            <td><b>Semester:</b> V</td>
            <td><b>Section:</b> A</td>
            <td><b>Room No:</b> 16109</td>
            <td><b>w.e.f:</b> 04-08-2026</td>
        </tr>
    </table>

    <br>

    <table class="timetable">

        <tr>
            <th rowspan="2">DAY</th>
            <th>1</th>
            <th>2</th>
            <th>3</th>
            <th>4</th>
            <th>5</th>
            <th>6</th>
            <th>7</th>
            <th>8</th>
            <th>9</th>
        </tr>

        <tr>
            <th>09:00-10:00</th>
            <th>10:00-11:00</th>
            <th>11:00-12:00</th>
            <th>12:00-01:00</th>
            <th>01:00-01:50</th>
            <th>01:50-02:40</th>
            <th>02:40-02:50</th>
            <th>02:50-03:40</th>
            <th>03:40-04:30</th>
        </tr>

        <!-- MONDAY -->
        <tr>
            <td class="day">Monday</td>
            <td colspan="2" class="lab">CN Lab</td>
            <td class="subject1">AI</td>

            <td rowspan="6" class="lunch">
                L<br>U<br>N<br>C<br>H
            </td>

            <td colspan="2" class="subject2">SP</td>

            <td rowspan="6" class="break">
                B<br>R<br>E<br>A<br>K
            </td>

            <td class="subject3">AOR</td>
            <td class="subject4">DWDM</td>
        </tr>

        <!-- TUESDAY -->
        <tr>
            <td class="day">Tuesday</td>
            <td colspan="2" class="lab">FSDI Lab</td>
            <td class="subject1">AT&CD</td>
            <td colspan="2" class="subject2">SP</td>
            <td class="subject3">DWDM / NCC</td>
            <td class="subject4">CN / NCC</td>
        </tr>

        <!-- WEDNESDAY -->
        <tr>
            <td class="day">Wednesday</td>
            <td colspan="3" class="lab">NPTEL / Skilling</td>
            <td class="subject1">AOR</td>
            <td class="subject2">AT&CD</td>
            <td colspan="2" class="subject3">SP</td>
        </tr>

        <!-- THURSDAY -->
        <tr>
            <td class="day">Thursday</td>
            <td colspan="2" class="lab">UIF Flutter Lab</td>
            <td class="subject1">AT&CD</td>
            <td class="subject2">CN</td>
            <td class="subject3">AJ</td>
            <td colspan="2" class="subject4">APT</td>
        </tr>

        <!-- FRIDAY -->
        <tr>
            <td class="day">Friday</td>
            <td colspan="2" class="lab">AJ Lab</td>
            <td class="subject1">AJ</td>
            <td class="subject2">FSDI</td>
            <td class="subject3">CN</td>
            <td class="subject4">DWDM</td>
            <td class="subject1">AOR</td>
        </tr>

        <!-- SATURDAY -->
        <tr>
            <td class="day">Saturday</td>
            <td colspan="2" class="subject2">SPA</td>
            <td class="subject3">CN</td>
            <td class="subject4">AT&CD</td>
            <td class="subject1">AOR</td>
            <td class="subject2">AJ</td>
            <td class="subject3">DWDM</td>
        </tr>

    </table>

</center>

</body>
</html>
